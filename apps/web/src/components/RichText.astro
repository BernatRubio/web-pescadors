---
/** Renders a localised Portable Text field (internationalizedArrayRichText). */
import {
  LOCALE_TAGS,
  type Locale,
  type LocalizedValue,
  pickLocale,
  pickLocaleWithLang,
} from '@pescadors/shared';
import { PortableText } from 'astro-portabletext';
import Figure from './portable/Figure.astro';
import Link from './portable/Link.astro';

interface Props {
  value: unknown;
  locale: Locale;
  class?: string;
}

const { value, locale, class: className } = Astro.props;
type Block = { _type: string; _key: string; alt?: unknown; caption?: unknown };

const picked = pickLocaleWithLang(value as LocalizedValue<Block[]>, locale);
// A Catalan fallback on an es/en page is marked up as Catalan (WCAG 3.1.2).
const lang = picked && picked.lang !== locale ? LOCALE_TAGS[picked.lang] : undefined;

// Resolve the figures' translatable alt text and caption up front, so the
// Portable Text components don't need to know the locale.
const blocks = (picked?.value ?? []).map((block) =>
  block._type === 'figure'
    ? {
        ...block,
        altText: pickLocale(block.alt as LocalizedValue<string>, locale) ?? '',
        captionText: pickLocale(block.caption as LocalizedValue<string>, locale),
      }
    : block,
);
---

{
  blocks.length > 0 && (
    <div class:list={['rich-text', className]} lang={lang}>
      <PortableText value={blocks} components={{ type: { figure: Figure }, mark: { link: Link } }} />
    </div>
  )
}
