---
import { type Locale, localizedPath } from '@pescadors/shared';
import { t } from '../i18n/ui';
import { getSettings, getSponsors } from '../lib/content';
import { imageUrl, widthAtHeight } from '../lib/sanity/image';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const [settings, sponsors] = await Promise.all([getSettings(), getSponsors()]);
const main = sponsors.filter((s) => s.tier === 'principal');
const others = sponsors.filter((s) => s.tier !== 'principal');
const social = Object.entries(settings?.social ?? {}).filter(
  (entry): entry is [string, string] => typeof entry[1] === 'string' && entry[1].length > 0,
);
const socialLabel: Record<string, string> = {
  instagram: 'Instagram',
  facebook: 'Facebook',
  youtube: 'YouTube',
  tiktok: 'TikTok',
  x: 'X',
};
---

<footer class="bg-secondary text-on-secondary">
  <div class="mx-auto grid max-w-(--spacing-max-width) gap-xl px-md py-xl md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="headline-lg">{settings?.clubName ?? t(locale, 'site.name')}</p>
      {!settings?.address && <p class="mt-sm">{t(locale, 'site.place')}</p>}
      <ul class="mt-md space-y-xs">
        {settings?.email && <li><a class="footer-link" href={`mailto:${settings.email}`}>{settings.email}</a></li>}
        {settings?.phone && <li><a class="footer-link" href={`tel:${settings.phone.replace(/\s+/g, '')}`}>{settings.phone}</a></li>}
        {settings?.address && <li class="whitespace-pre-line">{settings.address}</li>}
      </ul>
      {
        social.length > 0 && (
          <ul class="mt-md flex flex-wrap gap-md" aria-label={t(locale, 'contact.social')}>
            {social.map(([key, url]) => (
              <li>
                <a class="footer-link" href={url} rel="noopener">
                  {socialLabel[key] ?? key}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      sponsors.length > 0 && (
        <div class="md:col-span-7">
          <h2 class="font-bold">
            <a class="footer-link" href={localizedPath('sponsors', locale)}>
              {t(locale, 'footer.sponsors')}
            </a>
          </h2>
          <ul class="mt-md flex flex-wrap items-center gap-lg">
            {[...main, ...others].map((s) => {
              const logo = imageUrl(s.logo, s.tier === 'principal' ? 320 : 200);
              const isMain = s.tier === 'principal';
              const size = isMain ? 'h-14' : 'h-9';
              // Rendered height minus the p-xs padding on both sides.
              const px = isMain ? 56 - 8 : 36 - 8;
              const content = logo ? (
                <img src={logo} alt={s.name ?? ''} width={widthAtHeight(s.logo, px)} height={px} class:list={[size, 'w-auto bg-surface p-xs']} loading="lazy" />
              ) : (
                <span>{s.name}</span>
              );
              return <li>{s.url ? <a href={s.url} rel="sponsored noopener">{content}</a> : content}</li>;
            })}
          </ul>
        </div>
      )
    }
  </div>
</footer>

<style>
  .footer-link {
    color: var(--color-on-secondary);

    &:hover {
      background: var(--color-secondary-light);
    }
  }
</style>
