---
import {
  LOCALE_LABELS,
  LOCALE_TAGS,
  LOCALES,
  type Locale,
  localizedPath,
  type RouteKey,
} from '@pescadors/shared';
import SiteFooter from '../components/SiteFooter.astro';
import { mainNav, pageTitles, t } from '../i18n/ui';
import { getSettings } from '../lib/content';
import { imageUrl } from '../lib/sanity/image';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Same page in each language (hreflang + language switcher). */
  alternates: Record<Locale, string>;
  /** Highlights the current section in the menu. */
  section?: RouteKey;
  ogImage?: string | null;
}

const { locale, title, description, alternates, section, ogImage } = Astro.props;
const settings = await getSettings();
const siteName = settings?.clubName ?? t(locale, 'site.name');
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(alternates[locale], Astro.site);
const noindex = import.meta.env.PUBLIC_NOINDEX === 'true';
const logo = imageUrl(settings?.logo, 128);
const shareImage = ogImage ?? imageUrl(settings?.logo, 1200);
---

<!doctype html>
<html lang={LOCALE_TAGS[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={LOCALE_TAGS[l]} href={new URL(alternates[l], Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.ca, Astro.site)} />
    {logo && <link rel="icon" href={imageUrl(settings?.logo, 64)} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LOCALE_TAGS[locale].replace('-', '_')} />
    {description && <meta property="og:description" content={description} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      class="sr-only z-50 bg-on-surface p-sm text-on-primary focus:not-sr-only focus:fixed focus:top-sm focus:left-sm"
      href="#main">{t(locale, 'skip.link')}</a
    >

    <header class="border-b border-neutral">
      <div class="mx-auto flex min-h-[calc(var(--header-h)-1px)] max-w-(--spacing-max-width) flex-wrap items-center gap-x-sm gap-y-sm px-md py-xs md:gap-x-lg">
        <a href={localizedPath('home', locale)} class="mr-auto flex items-center gap-sm text-on-surface no-underline">
          {logo && <img src={logo} alt="" width="48" height="48" class="size-10 md:size-12" />}
          <span class="leading-tight">
            <span class="block text-lg font-extrabold [font-stretch:75%] md:text-xl">{siteName}</span>
            <span class="meta block">{t(locale, 'site.place')}</span>
          </span>
        </a>

        <nav aria-label={t(locale, 'lang.label')} class="md:order-last">
          <ul class="flex gap-sm">
            {
              LOCALES.map((l) => (
                <li>
                  <a
                    href={alternates[l]}
                    hreflang={LOCALE_TAGS[l]}
                    lang={LOCALE_TAGS[l]}
                    aria-label={LOCALE_LABELS[l]}
                    aria-current={l === locale ? 'true' : undefined}
                    class="meta no-underline hover:text-primary-ink aria-[current=true]:text-on-surface aria-[current=true]:underline"
                  >
                    {l}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <button
          type="button"
          class="lightbox-button px-sm py-xs md:hidden"
          aria-expanded="false"
          aria-controls="site-nav"
          data-nav-toggle
        >
          {t(locale, 'nav.open')}
        </button>

        <div id="site-nav" class="site-nav w-full md:flex md:w-auto md:items-center md:gap-lg">
          <nav aria-label={t(locale, 'nav.label')}>
            <ul class="flex flex-col gap-xs py-sm md:flex-row md:gap-md md:py-0">
              {
                mainNav.map((key) => (
                  <li>
                    <a
                      href={localizedPath(key, locale)}
                      aria-current={key === section ? 'page' : undefined}
                      class="font-semibold text-on-surface no-underline hover:text-primary-ink aria-[current=page]:text-primary-ink aria-[current=page]:underline"
                    >
                      {pageTitles[key][locale]}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <SiteFooter locale={locale} />

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
      });
    </script>
  </body>
</html>

<style>
  /* Without JS the menu is always visible. With JS it collapses on small screens. */
  @media (width < 48rem) {
    :global(.js) .site-nav {
      display: none;
    }
    :global(.js) [aria-expanded='true'] + .site-nav {
      display: block;
    }
  }
</style>
