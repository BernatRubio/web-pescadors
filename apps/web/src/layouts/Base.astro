---
// Preloaded so the hull band doesn't render in a wide fallback font and reflow the hero.
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import {
  DEFAULT_LOCALE,
  LOCALE_LABELS,
  LOCALE_TAGS,
  LOCALES,
  type Locale,
  localizedPath,
  type RouteKey,
} from '@pescadors/shared';
import SiteFooter from '../components/SiteFooter.astro';
import { mainNav, pageTitles, t } from '../i18n/ui';
import { getSettings } from '../lib/content';
import { imageUrl } from '../lib/sanity/image';
import type { PageMeta } from '../lib/seo';
import '../styles/global.css';

interface Props {
  locale: Locale;
  meta: Pick<PageMeta, 'title'> & Partial<PageMeta>;
  /** Same page in each language (hreflang + language switcher). */
  alternates: Record<Locale, string>;
  /** Highlights the current section in the menu. */
  section?: RouteKey;
  /** Keep this page out of search engines even on the final domain (e.g. the 404). */
  noindex?: boolean;
}

const { locale, meta, alternates, section } = Astro.props;
const { title, description, ogImage, ogType = 'website', jsonLd } = meta;
const translatedIn = meta.translatedIn ?? [...LOCALES];
const settings = await getSettings();
const siteName = settings?.clubName ?? t(locale, 'site.name');
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
// An untranslated page is the Catalan text again: point search engines at the original.
const canonicalLocale = translatedIn.includes(locale) ? locale : DEFAULT_LOCALE;
const canonical = new URL(alternates[canonicalLocale], Astro.site);
const hreflangs = LOCALES.filter((l) => translatedIn.includes(l) || l === DEFAULT_LOCALE);
const noindex = import.meta.env.PUBLIC_NOINDEX === 'true' || Astro.props.noindex;
const logo = imageUrl(settings?.logo, 128);
const shareImage = ogImage ?? imageUrl(settings?.logo, 1200);
---

<!doctype html>
<html lang={LOCALE_TAGS[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {
      hreflangs.length > 1 &&
        hreflangs.map((l) => (
          <link rel="alternate" hreflang={LOCALE_TAGS[l]} href={new URL(alternates[l], Astro.site)} />
        ))
    }
    {hreflangs.length > 1 && <link rel="alternate" hreflang="x-default" href={new URL(alternates.ca, Astro.site)} />}
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://cdn.sanity.io" />
    {logo && <link rel="icon" href={imageUrl(settings?.logo, 64)} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LOCALE_TAGS[locale].replace('-', '_')} />
    {description && <meta property="og:description" content={description} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')} />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      class="sr-only z-50 bg-on-surface p-sm text-on-primary focus:not-sr-only focus:fixed focus:top-sm focus:left-sm"
      href="#main">{t(locale, 'skip.link')}</a
    >

    <header class="border-b border-neutral">
      <div class="mx-auto flex min-h-[calc(var(--header-h)-1px)] max-w-(--spacing-max-width) flex-wrap items-center gap-x-sm gap-y-sm px-md py-xs md:gap-x-lg">
        <a href={localizedPath('home', locale)} class="mr-auto flex items-center gap-sm text-on-surface no-underline">
          {logo && <img src={logo} alt="" width="48" height="48" class="size-10 md:size-12" />}
          <span class="leading-tight">
            <span class="block text-lg font-extrabold [font-stretch:75%] md:text-xl">{siteName}</span>
            <span class="meta block">{t(locale, 'site.place')}</span>
          </span>
        </a>

        <nav aria-label={t(locale, 'lang.label')} class="lg:order-last">
          <ul class="flex gap-sm">
            {
              LOCALES.map((l) => (
                <li>
                  <a
                    href={alternates[l]}
                    hreflang={LOCALE_TAGS[l]}
                    lang={LOCALE_TAGS[l]}
                    aria-current={l === locale ? 'true' : undefined}
                    class="meta no-underline hover:text-primary-ink aria-[current=true]:text-on-surface aria-[current=true]:underline"
                  >
                    {l}
                    <span class="sr-only"> {LOCALE_LABELS[l]}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <button
          type="button"
          class="button-outline px-sm py-xs lg:hidden"
          aria-expanded="false"
          aria-controls="site-nav"
          data-nav-toggle
        >
          {t(locale, 'nav.open')}
        </button>

        <div id="site-nav" class="site-nav w-full lg:flex lg:w-auto lg:items-center lg:gap-lg">
          <nav aria-label={t(locale, 'nav.label')}>
            <ul class="flex flex-col gap-xs py-sm lg:flex-row lg:gap-md lg:py-0">
              {
                mainNav.map((key) => (
                  <li>
                    <a
                      href={localizedPath(key, locale)}
                      aria-current={key === section ? 'page' : undefined}
                      class="font-semibold text-on-surface no-underline hover:text-primary-ink aria-[current=page]:text-primary-ink aria-[current=page]:underline"
                    >
                      {pageTitles[key][locale]}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <SiteFooter locale={locale} />

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
      });
    </script>
  </body>
</html>

<style>
  /* Without JS the menu is always visible. With JS it collapses below 64rem, where the
     seven Catalan labels no longer fit on one row next to the crest (the header would wrap
     and break --header-h). */
  @media (width < 64rem) {
    :global(.js) .site-nav {
      display: none;
    }
    :global(.js) [aria-expanded='true'] + .site-nav {
      display: block;
    }
  }
</style>
