# Sanity project (the public, read-only dataset). Leave empty to build with empty content.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Public URL of the site (canonical links, sitemap, hreflang).
PUBLIC_SITE_URL=https://clubrempescadors.cat
# true while the MVP is on workers.dev: adds noindex everywhere.
PUBLIC_NOINDEX=true
